# BAP-MOS: ignore local and runtime artifacts.
# Tracked: src/, configs/, experiments/, docs/, tests/,
#       scripts/{bapmos.sh,populate_*.sh,_populate_*.sh}, requirements*.txt,
#       results/README.md, results/example/ (placeholder CSVs), data/*/README.md, models/**/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Foundation weights (download locally; see docs/WEIGHTS.md) ---
# Do not commit SAM/MedSAM (or other) checkpoints. Ship only models/**/.gitkeep
# so the directory layout exists after clone.
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
models/**
!models/**/
!models/**/.gitkeep

# --- Training / inference / logging (not shipped) ---
runs/
/inference_output/
wandb/
logs/
optuna_studies/
results_scratch/

# --- Local data corpora (not shipped; keep READMEs) ---
# Symlinks or real trees under data/* except documentation
data/prostate/**
!data/prostate/README.md
data/bladder/**
!data/bladder/README.md

# --- Results: tables written by a run stay local; only the placeholder examples are shipped ---
/results/**/*.csv
!/results/example/**/*.csv
results/**/_tmp_*/
results/**/_tmp_*
results/**/*audit*
results/**/*status*

# --- Notebooks / misc local ---
.ipynb_checkpoints/
*.log
debug.log
debug-internal.log
